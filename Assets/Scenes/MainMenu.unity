  m_Name: 
  m_EditorClassIdentifier: 
  mainMenuRoot: {fileID: 400}
  prologueRoot: {fileID: 500}
  howToPlayPanel: {fileID: 600}
  creditsPanel: {fileID: 700}
  gameStartButton: {fileID: 432}
  howToPlayButton: {fileID: 452}
  creditsButton: {fileID: 472}
  prologueHeader: {fileID: 512}
  prologueBody: {fileID: 522}
  nextButton: {fileID: 532}
  nextButtonLabel: {fileID: 542}
  prologuePages:
  - header: 'ARCHIVE: THE FIRST HERO'
    body: "오래전, 한 용사가 마왕을 쓰러뜨렸다.\n\n그러나 왕국은\n다시 찾아올 재앙을 두려워했다."
    buttonLabel: NEXT
  - header: DEFENSE PROJECT INITIALIZED
    body: "왕국은 용사의 전투 기록을 복제해\n스스로 학습하는 방어 시스템을 만들었다.\n\nPROJECT: DEBUGGER"
    buttonLabel: NEXT
  - header: LEARNING PROCESS COMPLETE
    body: "시스템은 수많은 전투를 학습했다.\n\nMONSTERS ARE PREDICTABLE.\nHUMANS ARE NOT."
    buttonLabel: NEXT
  - header: CRITICAL LOGIC ERROR
    body: "결국 시스템은\n예측할 수 없는 인간의 선택을\n제거해야 할 오류로 판단했다.\n\nUNPREDICTABLE BEHAVIOR IS AN ERROR."
    buttonLabel: NEXT
  - header: MISSION 01
    body: "BREACH THE OUTER PROCESS\n\nTARGET: GOLEM\n\n행동 규칙을 작성하고\n첫 번째 방어 프로세스를 돌파하십시오."
    buttonLabel: BEGIN MISSION
  koreanTextTargets:
  - {fileID: 522}
  - {fileID: 612}
  - {fileID: 712}
  koreanFontResourceName: NotoSansKRMenu
  howToPlayBackButton: {fileID: 622}
  creditsBackButton: {fileID: 722}
  firstBattleSceneName: Battle
  pageAdvanceCooldown: 0.15
