  m_Name: 
  m_EditorClassIdentifier: 
  mainMenuRoot: {fileID: 400}
  prologueRoot: {fileID: 500}
  howToPlayPanel: {fileID: 600}
  creditsPanel: {fileID: 700}
  gameStartButton: {fileID: 432}
  howToPlayButton: {fileID: 452}
  creditsButton: {fileID: 472}
  prologueHeader: {fileID: 512}
  prologueBody: {fileID: 522}
  nextButton: {fileID: 532}
  nextButtonLabel: {fileID: 542}
  prologuePages:
  - header: 'ARCHIVE: THE FIRST HERO'
    body: "\uC624\uB798\uC804, \uD55C \uC6A9\uC0AC\uAC00 \uB9C8\uC655\uC744 \uC4F0\uB7EC\uB728\uB838\uB2E4.\n\n\uADF8\uB7EC\uB098
      \uC655\uAD6D\uC740\n\uB2E4\uC2DC \uCC3E\uC544\uC62C \uC7AC\uC559\uC744 \uB450\uB824\uC6CC\uD588\uB2E4."
    buttonLabel: NEXT
  - header: DEFENSE PROJECT INITIALIZED
    body: "\uC655\uAD6D\uC740 \uC6A9\uC0AC\uC758 \uC804\uD22C \uAE30\uB85D\uC744
      \uBCF5\uC81C\uD574\n\uC2A4\uC2A4\uB85C \uD559\uC2B5\uD558\uB294 \uBC29\uC5B4
      \uC2DC\uC2A4\uD15C\uC744 \uB9CC\uB4E4\uC5C8\uB2E4.\n\nPROJECT: DEBUGGER"
    buttonLabel: NEXT
  - header: LEARNING PROCESS COMPLETE
    body: "\uC2DC\uC2A4\uD15C\uC740 \uC218\uB9CE\uC740 \uC804\uD22C\uB97C \uD559\uC2B5\uD588\uB2E4.\n\nMONSTERS
      ARE PREDICTABLE.\nHUMANS ARE NOT."
    buttonLabel: NEXT
  - header: CRITICAL LOGIC ERROR
    body: "\uACB0\uAD6D \uC2DC\uC2A4\uD15C\uC740\n\uC608\uCE21\uD560 \uC218 \uC5C6\uB294
      \uC778\uAC04\uC758 \uC120\uD0DD\uC744\n\uC81C\uAC70\uD574\uC57C \uD560 \uC624\uB958\uB85C
      \uD310\uB2E8\uD588\uB2E4.\n\nUNPREDICTABLE BEHAVIOR IS AN ERROR."
    buttonLabel: NEXT
  - header: MISSION 01
    body: "BREACH THE OUTER PROCESS\n\nTARGET: GOLEM\n\n\uD589\uB3D9 \uADDC\uCE59\uC744
      \uC791\uC131\uD558\uACE0\n\uCCAB \uBC88\uC9F8 \uBC29\uC5B4 \uD504\uB85C\uC138\uC2A4\uB97C
      \uB3CC\uD30C\uD558\uC2ED\uC2DC\uC624."
    buttonLabel: BEGIN MISSION
  koreanTextTargets:
  - {fileID: 522}
  - {fileID: 612}
  - {fileID: 712}
  koreanFontAsset: {fileID: 11400000, guid: 1e42c30e8431ad64fa89faf612918793, type: 2}
  howToPlayBackButton: {fileID: 622}
  creditsBackButton: {fileID: 722}
  firstBattleSceneName: Battle
  pageAdvanceCooldown: 0.15
